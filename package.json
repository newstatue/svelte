{
  "name": "svelte",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "wrangler types --check && vite build",
    "preview": "pnpm run build && wrangler dev",
    "prepare": "svelte-kit sync || echo ''",
    "check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "gen": "wrangler types",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "bits-ui": "^2.21.0",
    "cn": "^0.5.2",
    "phosphor-svelte": "^3.1.1",
    "shadcn-svelte": "^1.8.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "wrangler": "^4.163.0"
  },
  "dependencies": {
    "better-auth": "^1.7.25"
  }
}
